rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function newlyAddedIds(before, after) {
      return after.removeAll(before);
    }

    function isValidSingleCommunityJoin(uid, before, after) {
      let added = newlyAddedIds(before, after);
      return after.size() == before.size() + 1
        && after.hasAll(before)
        && added.size() == 1
        && existsAfter(/databases/$(database)/documents/communities/$(added[0])/members/$(uid));
    }

    function isValidSingleCommunityLeave(uid, before, after) {
      let removed = newlyAddedIds(after, before);
      return before.size() == after.size() + 1
        && before.hasAll(after)
        && removed.size() == 1
        && !existsAfter(/databases/$(database)/documents/communities/$(removed[0])/members/$(uid));
    }

    function canChangeRank(actorRank, targetRank, newRank) {
      return actorRank == "leader"
        || (
          actorRank == "admin"
          && newRank != "admin"
          && targetRank != "admin"
          && targetRank != "leader"
        );
    }

    function isValidRequestAcceptedJoin(uid, before, after) {
      let added = newlyAddedIds(before, after);
      return after.size() == before.size() + 1
        && after.hasAll(before)
        && added.size() == 1
        && getAfter(/databases/$(database)/documents/communities/$(added[0])/joinRequests/$(added[0] + "_" + uid)).data.status == "accepted"
        && getAfter(/databases/$(database)/documents/communities/$(added[0])/joinRequests/$(added[0] + "_" + uid)).data.reviewerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.get('verificationStatus', null) == resource.data.get('verificationStatus', null)
        && (
          request.resource.data.communityIds == resource.data.communityIds
          || isValidSingleCommunityJoin(uid, resource.data.communityIds, request.resource.data.communityIds)
          || isValidSingleCommunityLeave(uid, resource.data.communityIds, request.resource.data.communityIds)
        );
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["verificationStatus"]);
      allow update: if request.auth != null
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["communityIds"])
        && isValidRequestAcceptedJoin(uid, resource.data.communityIds, request.resource.data.communityIds);
    }

    match /applications/{applicationId} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "institutional_account";
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]);
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    match /communities/{communityId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.founderId == request.auth.uid
        && request.resource.data.type != "global"
        && (
          request.resource.data.type != "city"
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        )
        && (
          request.resource.data.type != "country"
          || (
            communityId.matches('^country_[A-Z]{2}$')
            && existsAfter(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid))
          )
        )
        && (
          request.resource.data.type != "institution"
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('verificationStatus', null) == "approved"
        )
        && (
          request.resource.data.isTeamSociety != true
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "coach"
        );
      match /members/{memberUid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == memberUid
          && request.resource.data.rank in ["member", "senior"]
          && getAfter(/databases/$(database)/documents/communities/$(communityId)).data.entranceType == "open";
        allow create: if request.auth != null
          && request.auth.uid == memberUid
          && request.resource.data.rank == "leader"
          && !exists(/databases/$(database)/documents/communities/$(communityId))
          && getAfter(/databases/$(database)/documents/communities/$(communityId)).data.founderId == request.auth.uid;
        allow create: if request.auth != null
          && request.auth.uid == memberUid
          && request.resource.data.rank == "member"
          && exists(/databases/$(database)/documents/invites/$(communityId + "_" + memberUid))
          && get(/databases/$(database)/documents/invites/$(communityId + "_" + memberUid)).data.status == "pending"
          && get(/databases/$(database)/documents/invites/$(communityId + "_" + memberUid)).data.inviteeUid == memberUid
          && getAfter(/databases/$(database)/documents/invites/$(communityId + "_" + memberUid)).data.status == "accepted";
        allow create: if request.auth != null
          && request.auth.uid != memberUid
          && request.resource.data.rank == "member"
          && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid))
          && (
            get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.rank == "leader"
            || get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.rank == "admin"
          )
          && exists(/databases/$(database)/documents/communities/$(communityId)/joinRequests/$(communityId + "_" + memberUid))
          && get(/databases/$(database)/documents/communities/$(communityId)/joinRequests/$(communityId + "_" + memberUid)).data.status == "pending"
          && get(/databases/$(database)/documents/communities/$(communityId)/joinRequests/$(communityId + "_" + memberUid)).data.requesterUid == memberUid
          && getAfter(/databases/$(database)/documents/communities/$(communityId)/joinRequests/$(communityId + "_" + memberUid)).data.status == "accepted";
        allow update: if request.auth != null
          && request.auth.uid != memberUid
          && request.resource.data.rank in ["admin", "senior", "member"]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rank"])
          && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid))
          && canChangeRank(
               get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.rank,
               resource.data.rank,
               request.resource.data.rank
             );
        allow update: if request.auth != null
          && request.auth.uid == memberUid
          && resource.data.rank == "leader"
          && request.resource.data.rank == "admin"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rank"])
          && get(/databases/$(database)/documents/communities/$(communityId)).data.type != "institution";
        allow update: if request.auth != null
          && request.auth.uid != memberUid
          && request.resource.data.rank == "leader"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rank"])
          && get(/databases/$(database)/documents/communities/$(communityId)).data.type != "institution"
          && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.rank == "leader"
          && getAfter(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.rank == "admin";
        allow delete: if request.auth != null
          && request.auth.uid == memberUid
          && resource.data.rank != "leader";
      }
      match /joinRequests/{requestId} {
        allow read: if request.auth != null
          && (
            request.auth.uid == resource.data.requesterUid
            || (
              exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid))
              && get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.rank in ["leader", "admin"]
            )
          );
        allow create: if request.auth != null
          && request.resource.data.requesterUid == request.auth.uid
          && request.resource.data.communityId == communityId
          && request.resource.data.status == "pending"
          && get(/databases/$(database)/documents/communities/$(communityId)).data.entranceType == "limited";
        allow update: if request.auth != null
          && resource.data.status == "pending"
          && request.resource.data.status == "declined"
          && request.resource.data.reviewerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "reviewerUid"])
          && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid))
          && (
            get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.rank == "leader"
            || get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.rank == "admin"
          );
        allow update: if request.auth != null
          && resource.data.status == "pending"
          && request.resource.data.status == "accepted"
          && request.resource.data.reviewerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "reviewerUid"])
          && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid))
          && (
            get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.rank == "leader"
            || get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.rank == "admin"
          )
          && existsAfter(/databases/$(database)/documents/communities/$(communityId)/members/$(resource.data.requesterUid));
      }
    }
    match /cityRequests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending";
    }
    match /invites/{inviteId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.inviterUid || request.auth.uid == resource.data.inviteeUid);
      allow create: if request.auth != null
        && request.resource.data.inviterUid == request.auth.uid
        && request.resource.data.status == "pending"
        && exists(/databases/$(database)/documents/communities/$(request.resource.data.communityId)/members/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)/members/$(request.auth.uid)).data.rank == "leader"
          || get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)/members/$(request.auth.uid)).data.rank == "admin"
        );
      allow update: if request.auth != null
        && request.auth.uid == resource.data.inviteeUid
        && resource.data.status == "pending"
        && request.resource.data.status == "declined"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]);
      allow update: if request.auth != null
        && request.auth.uid == resource.data.inviteeUid
        && resource.data.status == "pending"
        && request.resource.data.status == "accepted"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && existsAfter(/databases/$(database)/documents/communities/$(resource.data.communityId)/members/$(request.auth.uid));
      allow update: if request.auth != null
        && request.resource.data.inviterUid == request.auth.uid
        && resource.data.status == "declined"
        && request.resource.data.status == "pending"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "createdAt", "inviterUid"])
        && exists(/databases/$(database)/documents/communities/$(resource.data.communityId)/members/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/communities/$(resource.data.communityId)/members/$(request.auth.uid)).data.rank == "leader"
          || get(/databases/$(database)/documents/communities/$(resource.data.communityId)/members/$(request.auth.uid)).data.rank == "admin"
        );
    }
  }
}